{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "ultrawide-layout",
    "name": "Ultrawide Layout",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Stretches the panel, console and graphs across 21:9 and 32:9 monitors. Works with any theme.",
    "author": "Jenslee",
    "provider": "UltrawideLayout\\UltrawideLayoutProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "uw"
    },
    "icon": "monitor"
}
